{
  "manifest_version": 3,
  "name": "Lesehilfe",
  "version": "0.5.0",
  "key": "",
  "description": "Explain code in GitHub PR reviews with a local AI agent (pi + your ChatGPT subscription).",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Lesehilfe"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ]
}
